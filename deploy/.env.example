# ==============================================================================
# ORACLE Deployment Environment Configuration Template
# Copy this file to .env and configure secrets prior to deployment.
# ==============================================================================

# Application Environment (production, development, test)
ENVIRONMENT=production
DEBUG=false

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=oracle_db
POSTGRES_USER=oracle_user
POSTGRES_PASSWORD=replace_with_a_secure_random_production_password_2026

# Database Migration & Startup Synchronization
WAIT_FOR_DB=true
RUN_MIGRATIONS=true
DB_CONNECT_TIMEOUT=30

# Composed SQLAlchemy Database URL (can be specified directly or assembled from components)
DATABASE_URL=postgresql+psycopg://oracle_user:replace_with_a_secure_random_production_password_2026@db:5432/oracle_db

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Host Bind IP for Frontend and Backend (default: 127.0.0.1 for local/SSH tunnel; set to 0.0.0.0 for direct public VM access)
HOST_BIND_IP=127.0.0.1

# Frontend Backend API Target (used during frontend build and runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Permitted Local Filesystem Snapshot Roots (comma-separated or JSON list)
PERMITTED_LOCAL_ROOTS=["/tmp/snapshots"]

# Dynamic Execution Policy Sandboxing
DOCKER_EXECUTABLE=docker
DEFAULT_EXECUTION_TIMEOUT_SECONDS=15
MAX_EXECUTION_TIMEOUT_SECONDS=60
MAX_EXECUTION_OUTPUT_BYTES=102400
MAX_EXECUTION_MEMORY_MB=256
MAX_EXECUTION_CPU_CORES=1.0
